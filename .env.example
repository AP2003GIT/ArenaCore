ARENA_HOST=127.0.0.1
ARENA_PORT=3000
RUST_LOG=arena_core=info
ARENA_STORAGE=memory
ARENA_DATABASE_URL=postgresql://arena:arena@127.0.0.1:55432/arenacore
ARENA_DB_MAX_CONNECTIONS=10
ARENA_DB_ACQUIRE_TIMEOUT_SECONDS=5
ARENA_RATE_LIMIT_REQUESTS=120
ARENA_RATE_LIMIT_WINDOW_SECONDS=60
ARENA_MATCH_BASE_GAP=100
ARENA_MATCH_GAP_GROWTH_PER_SECOND=10
ARENA_MATCH_MAX_GAP=1000
ARENA_RATING_K_FACTOR=32
# Leave false for production; true enables participant lifecycle commands for local development.
ARENA_MATCH_ALLOW_DEV_PARTICIPANTS=false
# Optional unpadded base64url Ed25519 public keys (raw 32-byte keys).
ARENA_MATCH_GAME_SERVER_PUBLIC_KEY=
ARENA_MATCH_ADMIN_PUBLIC_KEY=
ARENA_WS_CHANNEL_CAPACITY=32
ARENA_WS_HEARTBEAT_SECONDS=15
ARENA_WS_CLIENT_TIMEOUT_SECONDS=45

